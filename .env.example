# Doppler (https://doppler.com) is this project's secrets manager - `doppler run -- npm start`
# fetches ANTHROPIC_API_KEY/DATABASE_URL/JWT_SECRET at process start and injects them into the
# environment, so none of them need to live in a file at all. See README > Secrets management.
#
# This file is kept as a documented fallback for local-only iteration without a Doppler account
# (cp .env.example .env, fill in values, npm start) and to enumerate exactly which secret names
# need to exist in Doppler when setting a new project up there.

# Required to start the app at all (no fallback - server.js exits immediately if either is missing)
DATABASE_URL=
JWT_SECRET=

# Required only to get real AI replies from POST /api/chat. Can be left blank for local
# development - the app still starts, and chat requests fail gracefully (500) instead.
ANTHROPIC_API_KEY=
PORT=3000
NODE_ENV=development

# Optional - defaults to 20 requests per 60s per client if unset
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=

# Optional - defaults to 30 requests per 60s per client if unset
RATE_LIMIT_ORDERS_MAX=
RATE_LIMIT_ORDERS_WINDOW_MS=

# Optional - defaults to 10 requests per 60s per client if unset
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_AUTH_WINDOW_MS=

# Optional - defaults to "info". One of: trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=

# Optional - error monitoring/alerting via Sentry (see README > Monitoring & alerting). Blank
# means Sentry.init() is simply skipped and every Sentry.* call elsewhere becomes a no-op -
# same "degrades gracefully, nothing else needs to change" pattern as ANTHROPIC_API_KEY above.
SENTRY_DSN=

# Optional - frontend error/performance monitoring (see README > Distributed tracing). NOT read
# the same way as everything else above: Vite bakes VITE_-prefixed vars into the built bundle at
# `vite build` time, not from process.env at server startup. Setting this here does nothing for
# `npm run build`/Docker - it needs to be a real env var in the shell that runs the frontend
# build (or `frontend/.env` for `npm --prefix frontend run dev`), and for the Docker build
# specifically, a --build-arg (see docker-compose.yml). Blank means the frontend build simply
# never includes a DSN and frontend monitoring stays off.
VITE_SENTRY_DSN=
